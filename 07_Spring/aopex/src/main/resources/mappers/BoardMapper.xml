<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.scoula.mapper.BoardMapper">

    <insert id="insert"
            parameterType="org.scoula.domain.BoardVO"
            useGeneratedKeys="true"
            keyProperty="boardId">

        INSERT INTO tbl_board
        (
            title,
            writer,
            content
        )
        VALUES
            (
                #{title},
                #{writer},
                #{content}
            )

    </insert>

    <select id="getList"
            resultType="org.scoula.domain.BoardVO">

        SELECT *
        FROM tbl_board
        ORDER BY board_id DESC

    </select>

    <select id="get"
            resultType="org.scoula.domain.BoardVO">

        SELECT *
        FROM tbl_board
        WHERE board_id = #{boardId}

    </select>

</mapper>